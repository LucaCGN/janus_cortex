JANUS_CRYPTO_OPTIONS_DATABASE_BACKEND=postgres
JANUS_CRYPTO_OPTIONS_POSTGRES_ENABLED=1
JANUS_CRYPTO_OPTIONS_POSTGRES_URL=postgresql://crypto_options:crypto_options_dev@127.0.0.1:55433/crypto_options
JANUS_CRYPTO_OPTIONS_REDIS_ENABLED=0
JANUS_CRYPTO_OPTIONS_REDIS_URL=redis://127.0.0.1:56379/0

# Compatibility aliases for tools that still use the shared Janus Postgres helper.
JANUS_POSTGRES_HOST=127.0.0.1
JANUS_POSTGRES_PORT=55433
JANUS_POSTGRES_DB=crypto_options
JANUS_POSTGRES_USER=crypto_options
JANUS_POSTGRES_PASSWORD=crypto_options_dev
